            "b": -1.05,
            "offset_adc": 12
          },
          {
            "index": 4,
            "a": 123000,
            "b": -1.05,
            "offset_adc": 12
          },
          {
            "index": 5,
            "a": 123000,
            "b": -1.05,
            "offset_adc": 12
          }
        ]
      }
    },
