{
  "description": "Calibration blobs (JSON text, read from the Calibration characteristic). Valid cases are the output of the TS parser. For malformed blobs the TS parser throws; \"rejected\" is the RejectReason the Dart parser must return and \"ts_message\" is what TS threw.",
  "cases": [
    {
      "name": "contract_example_6_channels",
      "reference": "ts-parser",
      "text": "{\"device_id\":\"INSOLE-L-001\",\"r_pulldown_ohm\":10000,\"sensor_area_m2\":0.000113,\"channels\":[{\"index\":0,\"a\":123000,\"b\":-1.05,\"offset_adc\":12},{\"index\":1,\"a\":123000,\"b\":-1.05,\"offset_adc\":12},{\"index\":2,\"a\":123000,\"b\":-1.05,\"offset_adc\":12},{\"index\":3,\"a\":123000,\"b\":-1.05,\"offset_adc\":12},{\"index\":4,\"a\":123000,\"b\":-1.05,\"offset_adc\":12},{\"index\":5,\"a\":123000,\"b\":-1.05,\"offset_adc\":12}]}",
      "expected": {
        "rejected": null,
        "device_id": "INSOLE-L-001",
        "r_pulldown_ohm": 10000,
        "sensor_area_m2": 0.000113,
        "channels": [
          {
            "index": 0,
            "a": 123000,
            "b": -1.05,
            "offset_adc": 12
          },
          {
            "index": 1,
            "a": 123000,
            "b": -1.05,
            "offset_adc": 12
