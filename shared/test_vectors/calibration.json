        "sensor_area_m2": 0.000113,
        "channels": [
          {
            "index": 0,
            "a": 123000,
            "b": -1.05,
            "offset_adc": 12
          },
          {
            "index": 1,
            "a": 98000,
            "b": -1.02,
            "offset_adc": 0
          },
          {
