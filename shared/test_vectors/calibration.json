    {
      "name": "not_json",
      "reference": "ts-parser",
      "text": "{\"device_id\": \"INSOLE-L-001\",",
      "expected": {
        "rejected": "calibrationNotJson",
        "ts_message": "Calibration blob is not valid JSON"
      }
    },
    {
      "name": "empty_text",
      "reference": "ts-parser",
      "text": "",
      "expected": {
        "rejected": "calibrationNotJson",
        "ts_message": "Calibration blob is not valid JSON"
      }
