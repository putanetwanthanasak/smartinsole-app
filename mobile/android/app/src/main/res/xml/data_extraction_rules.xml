<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): nothing of this app leaves the phone, neither by
     Google cloud backup nor by device-to-device transfer (S6A). The database,
     foot photos and research capture files are health / study data (IRB,
     FLUTTER-PLAN rule 15). allowBackup="false" alone does not stop
     device-to-device transfer on Android 12+, hence these rules. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
