<?xml version="1.0" encoding="utf-8"?>
<!-- The release build's resource shrinker removes drawables no code
     references by R.id. flutter_local_notifications looks the reminder
     icon up by name at runtime, so keep it (without this the release APK
     fails reminder setup with "invalid_icon"; found on the Note 10, S8C). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_foot_check" />
