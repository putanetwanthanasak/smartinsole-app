  "fixed_sql": [
    {
      "name": "foot_checks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"foot_checks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"at_ms\" INTEGER NOT NULL, \"local_date\" TEXT NOT NULL, \"q_redness\" TEXT NULL, \"q_wound\" TEXT NULL, \"q_swelling\" TEXT NULL, \"result\" TEXT NOT NULL, \"photo_sole_left\" TEXT NULL, \"photo_sole_right\" TEXT NULL, \"photo_top_left\" TEXT NULL, \"photo_top_right\" TEXT NULL, \"answer_only\" INTEGER NOT NULL CHECK (\"answer_only\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "alerts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"alerts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"code\" TEXT NOT NULL, \"level\" INTEGER NOT NULL CHECK(\"level\" BETWEEN 1 AND 5), \"patient_status\" TEXT NOT NULL, \"side\" TEXT NULL, \"zone\" TEXT NULL, \"site\" TEXT NULL, \"measured_value\" REAL NULL, \"threshold\" REAL NULL, \"gait_class\" TEXT NULL, \"gait_confidence\" REAL NULL, \"details\" TEXT NULL, \"at_ms\" INTEGER NOT NULL, \"local_date\" TEXT NOT NULL, \"read_at_ms\" INTEGER NULL, \"capture_stamp\" TEXT NULL, \"foot_check_id\" INTEGER NULL REFERENCES foot_checks (id) ON DELETE SET NULL);"
        }
      ]
    },
    {
      "name": "temperature_readings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"temperature_readings\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"at_ms\" INTEGER NOT NULL, \"local_date\" TEXT NOT NULL, \"side\" TEXT NOT NULL, \"forefoot_c\" REAL NULL, \"heel_c\" REAL NULL, \"quality\" TEXT NOT NULL, \"time_from_arrival\" INTEGER NOT NULL CHECK (\"time_from_arrival\" IN (0, 1)), \"site0_c\" REAL NULL, \"site1_c\" REAL NULL, \"site2_c\" REAL NULL, \"site3_c\" REAL NULL, \"site4_c\" REAL NULL, \"site5_c\" REAL NULL, \"site6_c\" REAL NULL, \"site7_c\" REAL NULL, \"site0_q\" TEXT NULL, \"site1_q\" TEXT NULL, \"site2_q\" TEXT NULL, \"site3_q\" TEXT NULL, \"site4_q\" TEXT NULL, \"site5_q\" TEXT NULL, \"site6_q\" TEXT NULL, \"site7_q\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "daily_summary",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_summary\" (\"local_date\" TEXT NOT NULL, \"steps\" INTEGER NULL, \"walking_min\" INTEGER NULL, \"worn_min\" INTEGER NULL, \"max_delta_forefoot_c\" REAL NULL, \"max_delta_heel_c\" REAL NULL, \"max_delta_c\" REAL NULL, \"max_delta_site\" INTEGER NULL, \"alerts_l1\" INTEGER NOT NULL DEFAULT 0, \"alerts_l2\" INTEGER NOT NULL DEFAULT 0, \"alerts_l3\" INTEGER NOT NULL DEFAULT 0, \"alerts_l4\" INTEGER NOT NULL DEFAULT 0, \"alerts_l5\" INTEGER NOT NULL DEFAULT 0, \"foot_check_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"foot_check_done\" IN (0, 1)), \"updated_at_ms\" INTEGER NOT NULL, PRIMARY KEY (\"local_date\"));"
        }
      ]
    },
