# Build output — Vite writes here; never commit it.
dist/

# Dependencies
node_modules/

# Vite cache
.vite/

# OS / editor cruft
Thumbs.db
.DS_Store

# Personal Claude Code permission overrides — machine-specific, not project config.
.claude/settings.local.json

# Flutter / PlatformIO build output
.pio/
mobile/build/
.dart_tool/

# Simulator check script's Python virtualenv
firmware/simulator/tools/.venv/
__pycache__/

# Study data never enters this public repo (SR-1, report 042). Study session
# folders and files are named after SI- subject codes (TEST- rehearsals are
# not ignored: shared/capture_fixture/ uses them on purpose); exports and
# board captures belong in ~/smartinsole-data/, outside the repo.
SI-[0-9][0-9][0-9]*
.incoming/
smartinsole-data/
board-checks/
# Trained Model A files stay out of git until the consent form and IRB are
# checked (user decision 2026-11-09); the app builds with them locally.
mobile/assets/models/*.tflite
mobile/assets/models/normalization.json
